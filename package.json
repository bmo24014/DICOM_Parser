{
  "name": "shoulder-mri-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@cornerstonejs/core": "5.11.7",
    "@cornerstonejs/dicom-image-loader": "5.11.7",
    "@cornerstonejs/metadata": "5.11.7",
    "dicom-parser": "1.8.21",
    "events": "3.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
